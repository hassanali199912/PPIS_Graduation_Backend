# Database
DB_CONNECTION_2=mongodb://127.0.0.1:27017/your-db

# Auth
JWT_SECRET=your-jwt-secret

# Email OTP — option 1: Resend (recommended for production)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=onboarding@resend.dev

# Email OTP — option 2: SMTP (e.g. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Your App <your-email@gmail.com>"

# Dev only: use Ethereal test inbox when SMTP/Resend are not set
# OTP_USE_ETHEREAL=true

# SMS OTP via Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
